# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. For local dev you can run Postgres in Docker,
# or use a free hosted instance from Neon (neon.tech) or Supabase (supabase.com).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# The base URL of your app. http://localhost:3000 for local dev,
# your real domain (e.g. https://tournament-tracker.vercel.app) in production.
NEXTAUTH_URL="http://localhost:3000"

# A random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
